         land_cells = processing_raster_cat(CROPPED_RASTER_PATH, raster, prefix, land_cells)
 
     land_cells = geojson_to_gdf(f"{OUTPUT_DATA_PATH}/{scenario}", land_cells)
+
+    # GAEZ pixels can be absent beneath small coastal or island grid cells.
+    # Retain those boundary-derived cells and fill only missing raster
+    # attributes from the nearest covered land cell.  This prevents a
+    # no-data-only agricultural cluster without altering observed pixels.
+    projected = land_cells.to_crs(input_data['crs_proj'])
+    centroids = projected.geometry.centroid
+    coordinates = np.column_stack([centroids.x, centroids.y])
+    continuous_columns = [
+        col for col in land_cells.columns
+        if col not in base_columns and col.endswith("_mean")
+    ]
+    for col in continuous_columns:
+        missing = land_cells[col].isna().to_numpy()
+        valid = ~missing
+        if missing.any() and valid.any():
+            tree = cKDTree(coordinates[valid])
+            _, nearest = tree.query(coordinates[missing], k=1)
+            source_values = land_cells.loc[valid, col].iloc[nearest].to_numpy()
+            land_cells.loc[missing, col] = source_values
+
+    land_cover_columns = [
+        col for col in land_cells.columns if col.startswith("LCType")
+    ]
+    precipitation_column = next(
+        (col for col in continuous_columns if "prc" in col), None
+    )
+    if precipitation_column and land_cover_columns:
+        # Continuous attributes have already been filled, so identify original
+        # all-missing land-cover rows before replacing ordinary absent classes
+        # with zero.
+        no_land_cover = land_cells[land_cover_columns].isna().all(axis=1).to_numpy()
+        covered = ~no_land_cover
+        if no_land_cover.any() and covered.any():
+            tree = cKDTree(coordinates[covered])
+            _, nearest = tree.query(coordinates[no_land_cover], k=1)
+            source = land_cells.loc[covered, land_cover_columns].iloc[nearest]
+            land_cells.loc[no_land_cover, land_cover_columns] = source.to_numpy()
+        land_cells.loc[:, land_cover_columns] = (
+            land_cells[land_cover_columns].fillna(0)
+        )
+
     # Export as csv
     land_cells.to_csv(
